# Backend Configuration for Pepasur Solana
# 
# This file contains all environment variables needed to run the Pepasur backend
# with Solana blockchain integration.
#
# IMPORTANT: Copy this file to .env and fill in the actual values
# DO NOT commit .env file with real credentials to version control

# ==================== Solana Configuration ====================

# Solana Network (devnet, testnet, or mainnet-beta)
# - devnet: For development and testing (free SOL from faucet)
# - testnet: For pre-production testing
# - mainnet-beta: For production deployment
SOLANA_NETWORK=devnet

# Solana RPC URL
# Default devnet RPC endpoint (free but rate-limited)
SOLANA_RPC_URL=https://api.devnet.solana.com

# For mainnet, use:
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Pepasur Program ID (deployed Solana program address)
# This is the address of your deployed Solana program
# Update this after deploying your program with: anchor deploy
PEPASUR_PROGRAM_ID=FihMZFcyftuU7d7YtnZCfKthcQQpSbfBaTfDkDZGJDfd

# Server Private Key (for signing transactions)
# This should be a JSON array of 64 bytes representing the keypair
# 
# To generate a new keypair:
#   solana-keygen new -o ~/.config/solana/server-keypair.json
# 
# To view the keypair as JSON array:
#   cat ~/.config/solana/server-keypair.json
# 
# Example format: [1,2,3,4,...,64]
# SECURITY: Keep this secret! Never commit to version control!
SOLANA_SERVER_PRIVATE_KEY=[...]

# ==================== Server Configuration ====================

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# ==================== Database Configuration ====================

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/pepasur

# ==================== Game Settings ====================

# Default Game Phase Durations (in seconds)
DEFAULT_NIGHT_PHASE_DURATION=30
DEFAULT_RESOLUTION_PHASE_DURATION=10
DEFAULT_TASK_PHASE_DURATION=30
DEFAULT_VOTING_PHASE_DURATION=10
DEFAULT_MAX_TASK_COUNT=4

# ==================== Socket.IO Configuration ====================

# CORS Origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# ==================== Optional: Custom RPC ====================

# For better performance, you can use a custom RPC endpoint
# Examples:
# - Helius: https://rpc.helius.xyz/?api-key=YOUR_API_KEY
# - QuickNode: https://your-endpoint.solana-devnet.quiknode.pro/YOUR_TOKEN/
# - Alchemy: https://solana-devnet.g.alchemy.com/v2/YOUR_API_KEY

# Uncomment and set your custom RPC URL:
# SOLANA_RPC_URL=https://your-custom-rpc-endpoint.com

# ==================== Faucet Configuration ====================

# The server wallet will need SOL balance to fund the faucet
# Users can claim devnet SOL for testing
# Make sure SOLANA_SERVER_PRIVATE_KEY account has sufficient balance
# Get devnet SOL: solana airdrop 2 <ADDRESS> --url devnet
