# Solana Configuration for Pepasur Backend
#
# This is a Solana-specific environment configuration file
# Copy to .env and update with your actual values

# ==================== Solana Blockchain Configuration ====================

# Solana Network (devnet | testnet | mainnet-beta)
SOLANA_NETWORK=devnet

# Solana RPC URL
# Devnet (free, rate-limited):
SOLANA_RPC_URL=https://api.devnet.solana.com

# Mainnet (for production):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Program ID (deployed Solana program address)
# Update after deploying with: anchor deploy
PEPASUR_PROGRAM_ID=FihMZFcyftuU7d7YtnZCfKthcQQpSbfBaTfDkDZGJDfd

# Server Keypair (JSON array of 64 bytes)
# Generate: solana-keygen new -o server-keypair.json
# View: cat server-keypair.json
# Format: [1,2,3,...,64]
# SECURITY WARNING: Keep this secret!
SOLANA_SERVER_PRIVATE_KEY=[...]

# ==================== Optional: Custom RPC Configuration ====================

# For better performance and higher rate limits, use a custom RPC provider:
# 
# Helius (recommended for production):
# SOLANA_RPC_URL=https://rpc.helius.xyz/?api-key=YOUR_API_KEY
#
# QuickNode:
# SOLANA_RPC_URL=https://your-endpoint.solana-devnet.quiknode.pro/YOUR_TOKEN/
#
# Alchemy:
# SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_API_KEY

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB (existing)
MONGODB_URI=mongodb://localhost:27017/pepasur

# Socket.IO Configuration
CORS_ORIGIN=http://localhost:3000
